{
    "name": "schachbulle/contao-topwertungszahlen-bundle",
    "type": "contao-bundle",
    "description": "Stellt die Spitzenwertungszahlen des Deutschen Schachbundes als Ranglisten dar.",
    "keywords": [
        "contao",
        "schach",
        "dwz",
        "wertungszahl",
        "rangliste"
    ],
    "homepage": "https://github.com/Samson1964/contao-topwertungszahlen-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.3",
        "schachbulle/contao-helper-bundle": "^1.8.12 || ^2.0 || ^3.0",
        "schachbulle/contao-wertungsportal-bundle": "^1.35.2"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "doctrine/doctrine-cache-bundle": "^1.3"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoTopwertungszahlenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoTopwertungszahlenBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-topwertungszahlen-bundle/issues",
        "source": "https://github.com/Samson1964/contao-topwertungszahlen-bundle"
    }
}
